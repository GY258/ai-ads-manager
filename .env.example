# Mock mode: no keys, in-process Postgres (PGlite) and local file storage.
AI_MODE=mock            # mock | live | replay
DB_DRIVER=pglite        # pglite | postgres
STORAGE_DRIVER=local    # local | supabase
PGLITE_DIR=.data/db
LOCAL_STORAGE_DIR=.data/storage
DEFAULT_AD_COUNT=6

# Live mode
AI_GATEWAY_API_KEY=     # or VERCEL_OIDC_TOKEN via `vercel env pull`
CHAT_MODEL=google/gemini-2.5-flash
SUBAGENT_MODEL=openai/gpt-5-nano
QA_MODEL=google/gemini-2.5-flash-lite
IMAGE_MODEL=fal-ai/nano-banana/edit
FAL_KEY=
FIRECRAWL_API_KEY=      # optional; non-Shopify brand extraction

# Supabase (Vercel Marketplace integration sets these)
POSTGRES_URL=           # transaction pooler, :6543
POSTGRES_URL_NON_POOLING=   # migrations only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
